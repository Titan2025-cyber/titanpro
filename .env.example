# ─────────────────────────────────────────────────────────────────────────────
# Titan Pro — Production Environment Variables
# Set these in Railway under your service → "Variables" tab.
# NEVER commit real values. This file only documents what's needed.
# ─────────────────────────────────────────────────────────────────────────────

# --- REQUIRED IN PRODUCTION ---

# Where the SQLite database file lives. Point this at your Railway persistent
# volume mount path so data survives restarts and redeploys.
# Example: if your volume is mounted at /data, use /data/data.db
DATABASE_PATH=/data/data.db

# Secret used to encrypt sensitive fields at rest. Generate a long random string
# (e.g. run: openssl rand -hex 32) and keep it stable — changing it makes existing
# encrypted data unreadable.
TITAN_ENCRYPT_KEY=change-me-to-a-long-random-secret

# Railway sets PORT automatically — do NOT set it yourself.
# PORT=

# --- OPTIONAL: enable live payments (Stripe) ---
# Your LIVE Stripe secret key (starts with sk_live_...). Leave blank to keep
# payments in test/off mode.
STRIPE_SECRET_KEY=

# --- OPTIONAL: enable AI assistant features (Anthropic) ---
# A real Anthropic API key (starts with sk-ant-...). Leave blank and every AI
# feature (Daily File Audit, Scope->Email, Insurance Narrative, Inbox Responder,
# etc.) degrades gracefully to the built-in rules engine — the rest of the app
# works normally. Set this key to switch those features to true AI-written output.
ANTHROPIC_API_KEY=

# Optional: override which Anthropic model the AI features use. Defaults to
# claude-sonnet-4-6. Change it here without touching code if you want a
# different model (e.g. a cheaper or newer one).
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OPTIONAL: automatic database backups (on by default) ---
# Timestamped SQLite snapshots are written automatically ~10s after boot and
# then on a fixed interval. Defaults are sensible; override only if you want to.
# BACKUP_DIR=/data/backups          # where snapshots are written (defaults next to the DB)
# BACKUP_INTERVAL_HOURS=24          # how often to snapshot
# BACKUP_KEEP=14                    # how many snapshots to retain (older are pruned)
# BACKUP_DISABLED=1                 # set to 1 to turn automatic backups OFF

# --- NOT NEEDED HERE ---
# QuickBooks and Ramp credentials are entered inside the app (Settings →
# Integrations) and stored in the database — do not put them here.
